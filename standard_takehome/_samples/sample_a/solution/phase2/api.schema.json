{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "_samples/sample_a/solution/phase2/api.schema.json",
  "title": "Proposed Planning API v2 — batch planner",
  "description": "v2 moves assignment and per-part sequencing inside the planner. plan({scene}) returns one routine for the whole scene, plus an assignments view so the caller can see which part went where.",

  "$defs": {
    "planInput": {
      "type": "object",
      "required": ["scene"],
      "properties": {
        "scene": { "$ref": "../../../../src/schema.json#/$defs/scene" }
      }
    },

    "planOutput": {
      "type": "object",
      "required": ["steps", "assignments", "dropped"],
      "properties": {
        "steps": {
          "type": "array",
          "items": { "$ref": "../../../../src/schema.json#/$defs/step" },
          "description": "Wire steps for the whole scene, in order, produced by the batch planner."
        },
        "assignments": {
          "type": "array",
          "description": "Materialized view: which part went to which bin in the returned routine.",
          "items": {
            "type": "object",
            "required": ["partId", "binId"],
            "properties": {
              "partId": { "type": "string" },
              "binId": { "type": "string" }
            }
          }
        },
        "dropped": {
          "type": "array",
          "description": "Parts the planner chose to skip safely (no compatible bin, unreachable, etc.).",
          "items": {
            "type": "object",
            "required": ["partId", "reason"],
            "properties": {
              "partId": { "type": "string" },
              "reason": {
                "enum": ["unreachable", "no_compatible_bin", "capacity_full", "no_safe_route"]
              },
              "detail": { "type": "string" }
            }
          }
        },
        "notes": { "type": "string" }
      }
    }
  },

  "type": "object",
  "required": ["operations"],
  "properties": {
    "operations": {
      "type": "object",
      "properties": {
        "plan": {
          "description": "plan(input) → output. One call per scene, not one call per part.",
          "input":  { "$ref": "#/$defs/planInput" },
          "output": { "$ref": "#/$defs/planOutput" }
        }
      }
    }
  }
}
